@import url("https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&display=swap");

:root {
  --bg: #f2efe6;
  --ink: #1d2f2f;
  --ink-muted: #4d5d5d;
  --brand: #0f7a68;
  --brand-deep: #0a5b4d;
  --sun: #f4a259;
  --card: rgba(255, 255, 255, 0.9);
  --ring: rgba(15, 122, 104, 0.3);
  --shadow: 0 18px 40px rgba(24, 40, 40, 0.15);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Outfit", sans-serif;
  color: var(--ink);
  background:
    radial-gradient(circle at 10% 5%, rgba(244, 162, 89, 0.26), transparent 35%),
    radial-gradient(circle at 88% 12%, rgba(15, 122, 104, 0.2), transparent 30%),
    linear-gradient(180deg, #f8f2e8, #ece7da 60%, #f4f1ea);
  min-height: 100vh;
}

.app-shell {
  max-width: 1150px;
  margin: 0 auto;
  padding: 2.5rem 1.1rem 4rem;
}

.hero {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
  margin-bottom: 1.9rem;
  animation: rise 0.8s ease;
}

.hero-copy {
  background: linear-gradient(130deg, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.65));
  border-radius: 24px;
  padding: 1.6rem;
  box-shadow: var(--shadow);
  backdrop-filter: blur(6px);
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--brand);
  font-size: 0.76rem;
  font-weight: 700;
}

.hero h1 {
  font-family: "Fraunces", serif;
  font-size: clamp(2rem, 6vw, 3.25rem);
  margin: 0.7rem 0;
  line-height: 1.05;
}

.hero-copy p {
  color: var(--ink-muted);
  line-height: 1.55;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.7rem;
  margin-top: 1.1rem;
}

.hero-stats div {
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.7);
  padding: 0.7rem;
  text-align: center;
}

.hero-stats span {
  display: block;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--brand-deep);
}

.hero-stats p {
  font-size: 0.82rem;
  color: var(--ink-muted);
}

.featured-card {
  background: var(--card);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: var(--shadow);
  animation: rise 1.1s ease;
}

.featured-card img {
  width: 100%;
  height: 230px;
  object-fit: cover;
}

.featured-content {
  padding: 1.2rem;
}

.featured-content h2 {
  font-family: "Fraunces", serif;
  margin: 0.4rem 0 0.5rem;
}

.badge {
  display: inline-block;
  background: rgba(15, 122, 104, 0.11);
  color: var(--brand-deep);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: 999px;
  padding: 0.3rem 0.6rem;
}

.featured-tip {
  margin-top: 0.8rem;
  color: #775230;
  font-weight: 600;
}

.explorer-controls {
  background: rgba(255, 255, 255, 0.76);
  border-radius: 20px;
  padding: 1rem;
  box-shadow: var(--shadow);
  margin-bottom: 1.2rem;
  animation: rise 1.2s ease;
}

.explorer-controls input {
  width: 100%;
  border: 1px solid rgba(29, 47, 47, 0.14);
  border-radius: 12px;
  padding: 0.85rem 1rem;
  font-size: 1rem;
  font-family: inherit;
}

.explorer-controls input:focus,
.add-place-form input:focus,
.add-place-form textarea:focus {
  outline: 3px solid var(--ring);
  border-color: var(--brand);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin-top: 0.8rem;
}

.chip {
  border: none;
  border-radius: 999px;
  background: #d9e5e2;
  color: #2f4a47;
  font-weight: 600;
  padding: 0.5rem 0.95rem;
  cursor: pointer;
  transition: transform 0.2s ease, background 0.2s ease;
}

.chip:hover {
  transform: translateY(-1px);
}

.chip.active {
  background: var(--brand);
  color: #fff;
}

.places-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

.place-card {
  border-radius: 20px;
  overflow: hidden;
  background: var(--card);
  box-shadow: var(--shadow);
  animation: rise 0.7s ease;
}

.place-card img {
  width: 100%;
  height: 190px;
  object-fit: cover;
}

.place-body {
  padding: 1rem;
}

.place-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.7rem;
}

.place-head h3 {
  font-family: "Fraunces", serif;
  font-size: 1.35rem;
}

.place-head span {
  background: rgba(244, 162, 89, 0.2);
  color: #8a4e1f;
  border-radius: 999px;
  padding: 0.2rem 0.6rem;
  font-size: 0.78rem;
  font-weight: 700;
}

.meta {
  font-size: 0.9rem;
  color: #5b6a6a;
  margin: 0.4rem 0 0.5rem;
}

.tip {
  margin-top: 0.65rem;
  color: #304f4b;
  font-weight: 600;
}

.empty-state {
  border: 2px dashed rgba(15, 122, 104, 0.25);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.7);
  text-align: center;
  padding: 2rem 1rem;
}

.add-place-panel {
  margin-top: 1.6rem;
  border-radius: 24px;
  background: linear-gradient(140deg, #1d4e4a, #266f67);
  color: #ecf7f4;
  padding: 1.25rem;
  box-shadow: var(--shadow);
}

.add-place-panel h2 {
  font-family: "Fraunces", serif;
  font-size: 1.85rem;
}

.add-place-panel p {
  margin: 0.35rem 0 0.9rem;
  color: #cde7e2;
}

.add-place-form {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.65rem;
}

.add-place-form input,
.add-place-form textarea {
  border: 1px solid rgba(210, 235, 230, 0.4);
  background: rgba(255, 255, 255, 0.12);
  color: #f2fffd;
  border-radius: 12px;
  padding: 0.75rem 0.85rem;
  font-family: inherit;
  font-size: 0.98rem;
}

.add-place-form textarea {
  resize: vertical;
}

.add-place-form input::placeholder,
.add-place-form textarea::placeholder {
  color: rgba(232, 248, 244, 0.8);
}

.add-place-form button {
  border: none;
  border-radius: 12px;
  background: var(--sun);
  color: #302115;
  padding: 0.78rem 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.add-place-form button:hover {
  filter: brightness(1.05);
  transform: translateY(-1px);
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (min-width: 760px) {
  .app-shell {
    padding: 3rem 1.8rem 4rem;
  }

  .hero {
    grid-template-columns: 1.1fr 1fr;
    align-items: stretch;
  }

  .places-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .add-place-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .add-place-form textarea,
  .add-place-form button {
    grid-column: span 2;
  }
}

@media (min-width: 1050px) {
  .places-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
